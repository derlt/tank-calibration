{
  // The on-site page (§10a) as static assets, plus the optional cloud store:
  // a small JSON API on D1 (worker/index.js).  Only /api/* runs the Worker;
  // the page itself is a static asset.  Set up once: docs/cloud.md.
  "name": "tank-calibration-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./site/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tank-calibration", "database_id": "D1_DATABASE_ID" }
  ],
  // Per IP address.  A team on one phone hotspot shares one address, so the
  // API limit leaves room for about 30 devices.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
  // No ids or host names in this file: `make deploy` writes
  // wrangler.deploy.jsonc (not committed) with D1_DATABASE_ID from .env, and
  // sets API_HOSTS from .env.  The signup code is a secret:
  //   npx wrangler secret put SIGNUP_CODE
}
