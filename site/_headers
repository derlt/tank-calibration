# Security headers for the hosted page (Workers static assets).
# make deploy copies this file to site/public/_headers.
# The page is one file with inline script and style; it calls only its own
# site (/api/*).  connect-src 'self' stops fetch and XHR to other sites; it
# does not stop a navigation away from the page.  worker-src 'self' lets the
# page run its offline copy (sw.js, from this site only).  script-src holds
# the SHA-256 hash of each inline script of the page, written by
# `calib site-page` (make site): only those scripts run, so an injected
# script does not.  Do not edit the hashes by hand.  The page also puts no
# user text into HTML without escaping it.
/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-uO/+Psctv+bCBKW13kOHDga4uEN0LJlPM9BWXSJZR3I=' 'sha256-gnmm3ob3hvXDV+93cibcGmLbx+misyI0dUtakZvjfvA=' 'sha256-I45C8LBHWHrY6HhLagjMbCohahUFUkaM3ib9MWE17QQ=' 'sha256-PaUvuWE6Yead8xeWgY6JvLIV9pwuzy6Iy+oE+t7ZOlY=' 'sha256-vkOWBdSLp52riDL22ANJ25kzTu/lEZn1soCGbwRrM/g='; style-src 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
